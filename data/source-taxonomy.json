  "authorityRankGuidance": [
    {
      "rank": 1,
      "label": "Organizer or venue official page",
      "rule": "Prefer this when deduplicating or resolving conflicts."
    },
    {
      "rank": 2,
      "label": "Official town, county, library, or partner repost",
      "rule": "Useful when the organizer page is missing details."
    },
    {
      "rank": 3,
      "label": "Ticketing or registration page",
      "rule": "Use when official and registration details match."
    },
    {
      "rank": 4,
      "label": "Third-party directory",
      "rule": "Use mainly for discovery unless no official page is available."
    }
